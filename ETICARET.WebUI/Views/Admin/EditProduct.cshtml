@model ETICARET.WebUI.Models.ProductModel
@{
    ViewData["Title"] = "Ürünü Düzenle";
    Layout = "_AdminLayout";
}



<div class="container hb-admin-container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="hb-admin-card">
                <h2 class="hb-admin-title">Ürünü Düzenle</h2>

                <form asp-controller="Admin" asp-action="EditProduct" method="post" enctype="multipart/form-data">
                    <input type="hidden" asp-for="Id" />
                    
                    <div class="mb-4">
                        <label asp-for="Name" class="form-label hb-form-label">Ürün Adı</label>
                        <input asp-for="Name" class="form-control hb-form-control" />
                        <span asp-validation-for="Name" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label hb-form-label">Ürün Açıklaması</label>
                        <textarea asp-for="Description" class="form-control hb-form-control" rows="5"></textarea>
                        <span asp-validation-for="Description" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-4">
                        <label class="form-label hb-form-label">Kategoriler</label>
                        <select name="categoryIds" class="form-control hb-form-control" multiple style="min-height: 120px;">
                            @if(ViewBag.Categories != null)
                            {
                                foreach (var item in (List<ETICARET.Entities.Category>)ViewBag.Categories)
                                {
                                    var isSelected = Model.SelectedCategories != null && Model.SelectedCategories.Any(c => c.Id == item.Id) ? "selected" : "";
                                    <option value="@item.Id" selected="@(isSelected == "selected" ? "selected" : null)">@item.Name</option>
                                }
                            }
                        </select>
                        <small class="text-muted mt-1 d-block"><i class="fas fa-info-circle me-1"></i> Birden fazla kategori seçmek için CTRL tuşuna basılı tutun.</small>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6 mb-3 mb-md-0">
                            <label asp-for="Price" class="form-label hb-form-label">Fiyat (TL)</label>
                            <input asp-for="Price" class="form-control hb-form-control" type="number" step="0.01" />
                            <span asp-validation-for="Price" class="text-danger small mt-1 d-block"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Stock" class="form-label hb-form-label">Stok Adedi</label>
                            <input asp-for="Stock" class="form-control hb-form-control" type="number" step="1" />
                            <span asp-validation-for="Stock" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label hb-form-label">Ürün Görselleri</label>
                        <div class="d-flex flex-wrap border p-3 rounded" style="background-color: #fafafa;">
                            @if(Model.Images != null && Model.Images.Count > 0)
                            {
                                foreach(var img in Model.Images)
                                {
                                    <img src="@ProductImageHelper.GetUrl(img.ImageUrl)" alt="@Model.Name" width="80" class="rounded shadow-sm m-1 border" style="object-fit: cover; background: #fff;" onerror="this.src='@ProductImageHelper.GetUrl(null)'" />
                                }
                            }
                            else 
                            {
                                <span class="text-muted small py-2"><i class="far fa-image me-1"></i> Yüklü görsel bulunmuyor.</span>
                            }
                        </div>
                    </div>

                    <div class="d-flex justify-content-end mt-5 pt-3 border-top">
                        <a href="/admin/ProductList" class="hb-btn-outline me-3">İptal</a>
                        <button type="submit" class="hb-btn-primary">Değişiklikleri Kaydet</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
