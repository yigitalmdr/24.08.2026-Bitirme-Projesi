@model ETICARET.WebUI.Models.CategoryModel
@{
    ViewData["Title"] = "Kategoriyi Düzenle";
    Layout = "_AdminLayout";
}



<div class="container hb-admin-container">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="hb-admin-card">
                <h2 class="hb-admin-title">Kategoriyi Düzenle</h2>

                <form asp-controller="Admin" asp-action="EditCategory" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div class="mb-4">
                        <label asp-for="Name" class="form-label hb-form-label">Kategori Adı</label>
                        <input asp-for="Name" class="form-control hb-form-control" />
                        <span asp-validation-for="Name" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="d-flex justify-content-end mt-5 pt-3 border-top">
                        <a href="/admin/categorylist" class="hb-btn-outline me-3">İptal</a>
                        <button type="submit" class="hb-btn-primary">Değişiklikleri Kaydet</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
