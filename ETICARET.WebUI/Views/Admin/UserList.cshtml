@model List<ETICARET.WebUI.Identity.ApplicationUser>
@inject Microsoft.AspNetCore.Identity.UserManager<ETICARET.WebUI.Identity.ApplicationUser> UserManager
@{
    ViewData["Title"] = "Hesap Yönetimi";
    Layout = "_AdminLayout";
}



<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold text-dark m-0">Sistem Hesapları</h3>
</div>

<div class="hb-admin-card bg-white" style="border-radius:12px; overflow:hidden;">
    <div class="table-responsive">
        <table class="table hb-table table-hover m-0">
            <thead>
                <tr>
                    <th style="width: 80px;" class="text-center">Profil</th>
                    <th>Ad Soyad</th>
                    <th>Kullanıcı Adı</th>
                    <th>E-Posta Adresi</th>
                    <th style="width: 150px;" class="text-center">Durum</th>
                    <th style="width: 120px;" class="text-center">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if(Model != null && Model.Count > 0)
                {
                    foreach (var user in Model)
                    {
                        <tr>
                            <td class="text-center d-flex justify-content-center">
                                <div class="user-avatar">
                                    @(string.IsNullOrEmpty(user.FullName) ? "U" : user.FullName.Substring(0,1).ToUpper())
                                </div>
                            </td>
                            <td class="fw-bold">@(string.IsNullOrEmpty(user.FullName) ? "Belirtilmemiş" : user.FullName)</td>
                            <td class="text-muted">@("@" + user.UserName)</td>
                            <td><a href="mailto:@user.Email" class="text-decoration-none text-primary">@user.Email</a></td>
                            <td class="text-center">
                                @if (user.EmailConfirmed)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success p-2">Onaylı Hesap</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning bg-opacity-10 text-warning border border-warning p-2">Onaysız</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (await UserManager.IsInRoleAsync(user, "admin"))
                                {
                                    <span class="badge bg-secondary p-2"><i class="fas fa-shield-alt"></i> Yönetici</span>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-sm btn-outline-danger" title="Hesabı Sil" onclick="openDeleteModal('@user.Id', '@user.UserName')">
                                        <i class="fas fa-trash-alt"></i> Sil
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6">
                            <div class="p-5 text-center text-muted">
                                <i class="fas fa-users-slash mb-3" style="font-size: 3rem; color: #ccc;"></i>
                                <h5>Hiç hesap bulunamadı.</h5>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Styled Delete Confirmation Modal -->
<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-labelledby="deleteConfirmModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: 16px; border: none; box-shadow: 0 15px 35px rgba(0,0,0,0.1);">
            <div class="modal-header border-0 text-center flex-column pb-0 mt-4">
                <div class="icon-box mb-3 d-flex justify-content-center align-items-center mx-auto" style="width: 80px; height: 80px; border-radius: 50%; background: rgba(220, 53, 69, 0.1); color: #dc3545; font-size: 2.5rem;">
                    <i class="fas fa-exclamation-circle"></i>
                </div>
                <h4 class="modal-title w-100 fw-bold text-dark" id="deleteConfirmModalLabel">Emin misiniz?</h4>
            </div>
            <div class="modal-body text-center px-4 pt-3 pb-4">
                <p class="text-muted mb-0" style="font-size: 1.05rem;">
                    <strong id="deleteModalUserName" class="text-dark"></strong> adlı kullanıcı hesabını kalıcı olarak silmek üzeresiniz.<br/>Bu işlem geri alınamaz.
                </p>
            </div>
            <div class="modal-footer border-0 d-flex justify-content-center pb-4 pt-0 gap-3">
                <button type="button" class="btn btn-light px-4 py-2 fw-medium" data-bs-dismiss="modal" style="border-radius: 8px;">İptal</button>
                <form id="deleteForm" asp-controller="Admin" asp-action="DeleteUser" method="post" class="m-0">
                    <input type="hidden" name="userId" id="deleteModalUserId" value="" />
                    <button type="submit" class="btn btn-danger px-4 py-2 fw-medium" style="border-radius: 8px; box-shadow: 0 4px 10px rgba(220, 53, 69, 0.3);">Evet, Sil</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openDeleteModal(userId, userName) {
            document.getElementById('deleteModalUserId').value = userId;
            document.getElementById('deleteModalUserName').textContent = '@@' + userName;
            var myModal = new bootstrap.Modal(document.getElementById('deleteConfirmModal'));
            myModal.show();
        }
    </script>
}
