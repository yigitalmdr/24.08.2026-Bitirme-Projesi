@model ETICARET.WebUI.Models.OrderModel
@{
    ViewData["Title"] = "Alışverişi Tamamla";
    
    decimal totalPrice = Model.CartModel.TotalPrice();
    decimal discountAmount = 0;
    if (!string.IsNullOrEmpty(Model.DiscountCode) && Model.DiscountCode.ToUpper() == "UCUNCUBINYIL")
    {
        discountAmount = totalPrice * 0.2m;
    }
    decimal finalPrice = totalPrice - discountAmount;
}

<style>
    body { background-color: #f8f9fa; }
    .checkout-card {
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        border: 1px solid #eaeaea;
        padding: 30px;
        margin-bottom: 30px;
    }
    .checkout-title {
        font-size: 1.25rem;
        font-weight: 700;
        color: #333;
        margin-bottom: 25px;
        padding-bottom: 15px;
        border-bottom: 2px solid var(--bg-main, #f5f5f5);
    }
    .form-control, .form-select {
        border-radius: 8px;
        padding: 12px 15px;
        border: 1px solid #ddd;
        transition: all 0.2s;
    }
    .form-control:focus, .form-select:focus {
        border-color: var(--hb-orange, #ff6000);
        box-shadow: 0 0 0 3px rgba(255, 96, 0, 0.15);
    }
    .form-label {
        font-weight: 600;
        color: #555;
        font-size: 0.9rem;
    }
    .btn-submit-order {
        background-color: var(--hb-orange, #ff6000);
        color: white;
        border: none;
        padding: 15px;
        border-radius: 8px;
        font-weight: 700;
        font-size: 1.1rem;
        width: 100%;
        transition: all 0.2s;
    }
    .btn-submit-order:hover {
        background-color: #e55600;
        transform: translateY(-2px);
        box-shadow: 0 6px 15px rgba(255, 96, 0, 0.2);
    }
    
    /* Summary styles */
    .summary-item {
        display: flex;
        align-items: center;
        gap: 15px;
        padding-bottom: 15px;
        margin-bottom: 15px;
        border-bottom: 1px dashed #eaeaea;
    }
    .summary-item:last-child {
        border-bottom: none;
        margin-bottom: 0;
        padding-bottom: 0;
    }
    .summary-item-img {
        width: 60px;
        height: 60px;
        object-fit: contain;
        border-radius: 8px;
        border: 1px solid #eaeaea;
        padding: 5px;
    }
    .summary-item-title {
        font-weight: 600;
        font-size: 0.95rem;
        color: #333;
        line-height: 1.3;
    }
    .summary-totals {
        background: var(--bg-main, #f9f9f9);
        border-radius: 8px;
        padding: 20px;
        margin-top: 20px;
    }
    .summary-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 10px;
        color: #555;
        font-size: 0.95rem;
    }
    .summary-row.total {
        border-top: 2px solid #eaeaea;
        padding-top: 15px;
        margin-top: 5px;
        margin-bottom: 0;
        font-weight: 800;
        font-size: 1.25rem;
        color: var(--hb-orange, #ff6000);
    }
</style>

<div class="container mt-5 mb-5">
    <div class="row">
        <div class="col-12 mb-4">
            <h2 class="fw-bold" style="color: #484848;"><i class="fas fa-shopping-bag text-warning me-2"></i> Güvenli Ödeme</h2>
            <p class="text-muted">Siparişinizi tamamlamak için lütfen bilgilerinizi girin.</p>
        </div>
    </div>

    <form asp-controller="Cart" asp-action="Checkout" method="post">
        @if (TempData["PaymentError"] != null)
        {
            <div class="alert alert-danger mb-4 shadow-sm border-0 d-flex align-items-center">
                <i class="fas fa-exclamation-triangle fs-4 me-3"></i>
                <div>
                    <strong>Ödeme Başarısız!</strong><br />
                    @TempData["PaymentError"]
                </div>
            </div>
        }

        @if(!string.IsNullOrEmpty(Model.DiscountCode))
        {
            <input type="hidden" name="DiscountCode" value="@Model.DiscountCode" />
        }
        
        <div class="row">
            <div class="col-lg-8">
                <!-- Shipping Info -->
                <div class="checkout-card">
                    <h4 class="checkout-title"><i class="fas fa-truck me-2 text-muted"></i> Teslimat Bilgileri</h4>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Adınız</label>
                            <input type="text" class="form-control" name="FirstName" value="@Model.FirstName" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Soyadınız</label>
                            <input type="text" class="form-control" name="LastName" value="@Model.LastName" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">E-Posta</label>
                            <input type="email" class="form-control" name="Email" value="@Model.Email" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Telefon</label>
                            <input type="tel" class="form-control" name="Phone" placeholder="05XX XXX XX XX" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Şehir</label>
                            <input type="text" class="form-control" name="City" required>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Açık Adres</label>
                            <textarea class="form-control" name="Address" rows="3" required></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Sipariş Notu (Opsiyonel)</label>
                            <textarea class="form-control" name="OrderNote" rows="2"></textarea>
                        </div>
                    </div>
                </div>

                <!-- Payment Info -->
                <div class="checkout-card">
                    <h4 class="checkout-title"><i class="far fa-credit-card me-2 text-muted"></i> Ödeme Bilgileri</h4>
                    
                    <div class="alert alert-info border-info bg-white mb-4 d-flex align-items-center">
                        <i class="fas fa-shield-alt fs-3 text-info me-3"></i>
                        <div>
                            <strong>Güvenli Ödeme Noktası</strong><br />
                            Kart bilgileriniz 256-bit SSL sertifikası ile şifrelenerek bankaya iletilir.
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label">Kart Üzerindeki İsim</label>
                            <input type="text" class="form-control" name="CardName" required>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Kart Numarası</label>
                            <input type="text" class="form-control" name="CardNumber" placeholder="XXXX XXXX XXXX XXXX" maxlength="19" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Ay</label>
                            <select class="form-select" name="ExprationMonth" required>
                                <option value="">Seçiniz</option>
                                @for (int i = 1; i <= 12; i++)
                                {
                                    <option value="@i.ToString("00")">@i.ToString("00")</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Yıl</label>
                            <select class="form-select" name="ExprationYear" required>
                                <option value="">Seçiniz</option>
                                @for (int i = DateTime.Now.Year; i <= DateTime.Now.Year + 15; i++)
                                {
                                    <option value="@i">@i</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">CVV</label>
                            <input type="text" class="form-control" name="CVV" placeholder="XXX" maxlength="3" required>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Order Summary -->
            <div class="col-lg-4">
                <div class="checkout-card position-sticky" style="top: 20px;">
                    <h4 class="checkout-title"><i class="fas fa-shopping-basket me-2 text-muted"></i> Sepetiniz</h4>
                    
                    <div style="max-height: 350px; overflow-y: auto; padding-right: 10px;">
                        @foreach(var item in Model.CartModel.CartItems)
                        {
                            <div class="summary-item">
                                <img src="@ProductImageHelper.GetUrl(item.ImageUrl)" class="summary-item-img" alt="@item.Name" onerror="this.src='@ProductImageHelper.GetUrl(null)'" />
                                <div>
                                    <div class="summary-item-title">@item.Name</div>
                                    <div class="text-muted small mt-1">@item.Quantity Adet x @item.Price.ToString("c")</div>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="summary-totals">
                        <div class="summary-row">
                            <span>Ara Toplam</span>
                            <span>@totalPrice.ToString("c")</span>
                        </div>
                        <div class="summary-row">
                            <span>Kargo Ücreti</span>
                            <span class="text-success fw-bold">Ücretsiz</span>
                        </div>
                        
                        @if (discountAmount > 0)
                        {
                            <div class="summary-row text-success fw-bold">
                                <span>İndirim (Kupon: @Model.DiscountCode)</span>
                                <span>-@discountAmount.ToString("c")</span>
                            </div>
                        }
                        
                        <div class="summary-row total">
                            <span>Ödenecek Tutar</span>
                            <span>@finalPrice.ToString("c")</span>
                        </div>
                    </div>

                    <button type="submit" class="btn-submit-order mt-4">
                        Siparişi Onayla ve Bitir <i class="fas fa-check-circle ms-2"></i>
                    </button>
                    
                    <div class="text-center mt-3 text-muted" style="font-size: 0.85rem;">
                        Siparişi onaylayarak Mesafeli Satış Sözleşmesi'ni kabul etmiş olursunuz.
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>
