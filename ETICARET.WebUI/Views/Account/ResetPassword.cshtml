@model ResetPasswordModel
@{
    ViewData["Title"] = "Yeni Şifre Belirle";
}

@section Scripts {
    <script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
}

<style>
    body {
        background-color: #fcfcfc;
    }
    .hb-login-container {
        max-width: 420px;
        margin: 60px auto;
        background: #fff;
        padding: 40px 30px;
        border-radius: 12px;
        box-shadow: 0 4px 16px rgba(0,0,0,0.06);
        border: 1px solid #eaeaea;
    }
    .hb-login-title {
        font-size: 1.3rem;
        font-weight: 700;
        color: #484848;
        text-align: center;
        margin-bottom: 25px;
    }
    .hb-form-control {
        height: 52px;
        border-radius: 8px;
        border: 1px solid #d1d1d1;
        font-size: 15px;
        padding-left: 18px;
    }
    .hb-form-control:focus {
        border-color: var(--hb-orange, #ff6000);
        box-shadow: 0 0 0 0.2rem rgba(255, 96, 0, 0.15);
        outline: none;
    }
    .hb-btn-login {
        background-color: var(--hb-orange, #ff6000);
        color: #fff;
        height: 52px;
        font-weight: 700;
        font-size: 16px;
        border-radius: 8px;
        border: none;
        width: 100%;
        transition: background-color 0.2s;
        margin-top: 10px;
    }
    .hb-btn-login:hover {
        background-color: #e55600;
        color: #fff;
    }
</style>

<div class="container">
    <div class="hb-login-container">
        <h2 class="hb-login-title mt-2">Yeni Şifre Belirle</h2>
        <p class="text-center text-muted small mb-4">Lütfen hesabınız için güvenli, yeni bir şifre belirleyin.</p>

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 text-center small fw-bold"></div>

        <form asp-action="ResetPassword" asp-controller="Account">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Token" value="@Model.Token" />

            <div class="form-group mb-3">
                <input asp-for="Email" class="form-control hb-form-control" placeholder="E-posta Adresi" required />
                <span asp-validation-for="Email" class="text-danger small mt-1 d-block text-start"></span>
            </div>
            
            <div class="form-group mb-3">
                <input asp-for="Password" type="password" class="form-control hb-form-control" placeholder="Yeni Şifre" required />
                <span asp-validation-for="Password" class="text-danger small mt-1 d-block text-start"></span>
            </div>

            <div class="form-group mb-4">
                <input asp-for="RePassword" type="password" class="form-control hb-form-control" placeholder="Yeni Şifre (Tekrar)" required />
                <span asp-validation-for="RePassword" class="text-danger small mt-1 d-block text-start"></span>
            </div>

            <button type="submit" class="hb-btn-login">Şifremi Güncelle</button>
        </form>
    </div>
</div>
