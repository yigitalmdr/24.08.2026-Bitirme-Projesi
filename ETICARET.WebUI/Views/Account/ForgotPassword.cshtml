@{
    ViewData["Title"] = "Şifremi Unuttum";
}

<style>
    body {
        background-color: #fcfcfc;
    }
    .hb-login-container {
        max-width: 420px;
        margin: 60px auto;
        background: #fff;
        padding: 40px 30px;
        border-radius: 12px;
        box-shadow: 0 4px 16px rgba(0,0,0,0.06);
        border: 1px solid #eaeaea;
    }
    .hb-login-title {
        font-size: 1.3rem;
        font-weight: 700;
        color: #484848;
        text-align: center;
        margin-bottom: 25px;
    }
    .hb-form-control {
        height: 52px;
        border-radius: 8px;
        border: 1px solid #d1d1d1;
        font-size: 15px;
        padding-left: 18px;
    }
    .hb-form-control:focus {
        border-color: var(--hb-orange, #ff6000);
        box-shadow: 0 0 0 0.2rem rgba(255, 96, 0, 0.15);
        outline: none;
    }
    .hb-btn-login {
        background-color: var(--hb-orange, #ff6000);
        color: #fff;
        height: 52px;
        font-weight: 700;
        font-size: 16px;
        border-radius: 8px;
        border: none;
        width: 100%;
        transition: background-color 0.2s;
        margin-top: 10px;
    }
    .hb-btn-login:hover {
        background-color: #e55600;
        color: #fff;
    }
</style>

<div class="container">
    <div class="hb-login-container">
        <h2 class="hb-login-title mt-2">Şifremi Unuttum</h2>
        <p class="text-center text-muted small mb-4">Şifrenizi sıfırlamak için kayıtlı e-posta adresinizi girin. Size bir sıfırlama bağlantısı göndereceğiz.</p>

        <form asp-action="ForgotPassword" asp-controller="Account">
            <div class="form-group mb-3">
                <input name="Email" class="form-control hb-form-control" placeholder="E-posta Adresi" required />
            </div>

            <button type="submit" class="hb-btn-login">Şifremi Sıfırla</button>
            
            <a asp-action="Login" asp-controller="Account" class="d-block text-center mt-4 text-decoration-none" style="color: var(--hb-orange, #ff6000); font-weight: 600;">Giriş Sayfasına Dön</a>
        </form>
    </div>
</div>
