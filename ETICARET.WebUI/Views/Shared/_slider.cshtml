<div id="homeShowcase" class="carousel slide tb-carousel" data-bs-ride="carousel">
    <div class="carousel-indicators">
        <button type="button" data-bs-target="#homeShowcase" data-bs-slide-to="0" class="active" aria-current="true" aria-label="1. görsel"></button>
        <button type="button" data-bs-target="#homeShowcase" data-bs-slide-to="1" aria-label="2. görsel"></button>
        <button type="button" data-bs-target="#homeShowcase" data-bs-slide-to="2" aria-label="3. görsel"></button>
    </div>
    <div class="carousel-inner">
        <div class="carousel-item active">
            <div class="tb-campaign tb-campaign-indigo">
                <div class="tb-campaign-copy">
                    <span class="tb-campaign-tag"><i class="fas fa-sparkles"></i> Mobil teknoloji</span>
                    <h2>Yeni nesil hız,<br />cebinde.</h2>
                    <p>Güçlü performans, gelişmiş kamera ve modern tasarım seçeneklerini keşfet.</p>
                    <a href="/products/telefon" class="tb-campaign-link">Telefonları İncele <i class="fas fa-arrow-right"></i></a>
                </div>
                <div class="tb-campaign-visual"><img src="~/img/campaign/hero-phone-v2.png" alt="Yeni nesil akıllı telefon" /></div>
            </div>
        </div>
        <div class="carousel-item">
            <div class="tb-campaign tb-campaign-night">
                <div class="tb-campaign-copy">
                    <span class="tb-campaign-tag"><i class="fas fa-bolt"></i> Yüksek performans</span>
                    <h2>Fikirden ürüne,<br />daha hızlı.</h2>
                    <p>İş, eğitim ve üretkenlik için güçlü bilgisayarları tek koleksiyonda incele.</p>
                    <a href="/products/bilgisayar" class="tb-campaign-link">Bilgisayarları Keşfet <i class="fas fa-arrow-right"></i></a>
                </div>
                <div class="tb-campaign-visual"><img src="~/img/campaign/hero-laptop-v2.png" alt="Yüksek performanslı dizüstü bilgisayar" /></div>
            </div>
        </div>
        <div class="carousel-item">
            <div class="tb-campaign tb-campaign-fresh">
                <div class="tb-campaign-copy">
                    <span class="tb-campaign-tag"><i class="fas fa-house-signal"></i> Akıllı yaşam</span>
                    <h2>Evin sana<br />zaman kazandırsın.</h2>
                    <p>Günlük işleri kolaylaştıran akıllı ev teknolojileriyle hayatına alan aç.</p>
                    <a href="/products/ev gereçleri" class="tb-campaign-link">Akıllı Evi Keşfet <i class="fas fa-arrow-right"></i></a>
                </div>
                <div class="tb-campaign-visual"><img src="~/img/campaign/hero-vacuum-v2.png" alt="Akıllı robot süpürge" /></div>
            </div>
        </div>
    </div>
    <button class="carousel-control-prev" type="button" data-bs-target="#homeShowcase" data-bs-slide="prev"><span class="carousel-control-prev-icon" aria-hidden="true"></span><span class="visually-hidden">Önceki</span></button>
    <button class="carousel-control-next" type="button" data-bs-target="#homeShowcase" data-bs-slide="next"><span class="carousel-control-next-icon" aria-hidden="true"></span><span class="visually-hidden">Sonraki</span></button>
</div>
